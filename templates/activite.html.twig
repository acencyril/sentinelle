{# Le gabarit parent vient de la configuration : un bundle ne peut pas savoir
   comment l'application qui l'installe habille ses pages. #}
{% extends gabarit_parent %}

{% block title %}Activité du site{% endblock %}

{% block body %}
{% set teinte = {
    'attack_attempt': '#b91c1c', 'ip_blocked': '#1f2937', 'scan_probe': '#c2410c',
    'access_denied': '#a16207', 'server_error': '#7c3aed', 'not_found': '#64748b',
    'client_error': '#64748b', 'page_view': '#059669'
} %}
{% set nom = {
    'attack_attempt': "tentative d'exploitation", 'ip_blocked': 'IP bloquée',
    'scan_probe': 'sonde', 'access_denied': 'accès refusé',
    'server_error': 'erreur serveur', 'not_found': 'page introuvable',
    'client_error': 'erreur client', 'page_view': 'page vue'
} %}

{# ⚠ LE NOM DU PROPRIÉTAIRE SOUS L'ADRESSE. Sans lui, le tableau n'affiche que
   des chiffres et l'on bloque au hasard — c'est exactement ainsi qu'une IP de
   prestataire critique a été bannie à la main, coupant une fonction du site. #}
{% macro qui(ip, identites) %}
  {% set id = identites[ip]|default(null) %}
  {% if id and id.label %}
    <div style="font-size:.69rem;color:{{ id.critical ? '#b91c1c' : '#6b7280' }}">
      {{ id.critical ? '⛔ ' }}{{ id.label }}{{ id.critical ? ' — ne pas bloquer' }}
    </div>
  {% elseif id and id.hostname %}
    <div style="font-size:.69rem;color:#6b7280">{{ id.hostname }}</div>
  {% elseif id %}
    <div style="font-size:.69rem;color:#9ca3af;font-style:italic">inconnue (pas de DNS inverse)</div>
  {% endif %}
{% endmacro %}
{% import _self as w %}

<h1>Activité du site</h1>
{% if route_retour %}<p><a href="{{ path(route_retour) }}">← retour</a></p>{% endif %}

{% for message in app.flashes('sentinelle_ok') %}
  <p style="color:#059669">{{ message }}</p>
{% endfor %}
{% for message in app.flashes('sentinelle_erreur') %}
  <p style="color:#b91c1c">{{ message }}</p>
{% endfor %}

<h2>Dernières 24 heures</h2>
<p>
  {% for genre, total in resume %}
    <span style="color:{{ teinte[genre]|default('#64748b') }}">
      {{ nom[genre]|default(genre) }} : <strong>{{ total }}</strong></span>{{ not loop.last ? ' · ' }}
  {% else %}
    <span style="color:#9ca3af">Rien à signaler.</span>
  {% endfor %}
</p>

{% if bloquees is not empty %}
  <h2>Adresses bloquées</h2>
  <table>
    <tr><th>adresse</th><th>origine</th><th>motif</th><th>jusqu'à</th><th>récidives</th><th>refus</th><th></th></tr>
    {% for e in bloquees %}
      <tr>
        <td>{{ e.ip }}{{ w.qui(e.ip, identites) }}</td>
        <td>{{ e.source == 'manual' ? 'manuelle' : 'auto' }}</td>
        <td>{{ e.reason }}</td>
        <td>{{ e.isPermanent ? 'définitif' : e.expiresAt|date('d/m/Y H:i') }}</td>
        <td>{{ e.strikes > 1 ? e.strikes : '—' }}</td>
        <td>{{ e.hitCount ?: '—' }}</td>
        <td>
          <form method="post" action="{{ path('sentinelle_debloquer') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('sentinelle_bloquer') }}">
            <input type="hidden" name="ip" value="{{ e.ip }}">
            <button type="submit">débloquer</button>
          </form>
        </td>
      </tr>
    {% endfor %}
  </table>
{% endif %}

{% if tetes is not empty %}
  <h2>Adresses les plus actives sur 7 jours</h2>
  <table>
    <tr><th>adresse</th><th>anomalies</th><th>dernière</th><th></th></tr>
    {% for r in tetes %}
      <tr>
        <td>{{ r.ip }}{{ w.qui(r.ip, identites) }}</td>
        <td>{{ r.total }}</td>
        <td>{{ r.last|date('d/m/Y H:i') }}</td>
        <td>
          {% if bloqueesParIp[r.ip] is defined %}
            <span style="color:#9ca3af">déjà bloquée</span>
          {% else %}
            <form method="post" action="{{ path('sentinelle_bloquer') }}">
              <input type="hidden" name="_token" value="{{ csrf_token('sentinelle_bloquer') }}">
              <input type="hidden" name="ip" value="{{ r.ip }}">
              <button type="submit">bloquer</button>
            </form>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
  </table>
{% endif %}

<h2>Journal</h2>
<p>
  <a href="{{ path('sentinelle_activite') }}">tout</a> ·
  <a href="{{ path('sentinelle_activite', {filtre: 'suspicious'}) }}">seulement les anomalies</a>
</p>
<table>
  <tr><th>quand</th><th>genre</th><th>adresse</th><th>url</th><th>code</th><th>agent</th></tr>
  {% for e in evenements %}
    <tr>
      <td>{{ e.createdAt|date('d/m H:i:s') }}</td>
      <td style="color:{{ teinte[e.eventType]|default('#64748b') }}">{{ nom[e.eventType]|default(e.eventType) }}</td>
      <td>{{ e.ip ?: '—' }}{% if e.ip %}{{ w.qui(e.ip, identites) }}{% endif %}</td>
      <td style="word-break:break-all">
        {{ e.url }}
        {# ⚠ LE MOTIF ÉTAIT DANS LA QUERY, ET LA QUERY N'ÉTAIT PAS AFFICHÉE.
           `insert()` n'enregistre que le chemin ; ce qui a déclenché la
           détection vit dans `meta`. Deux tentatives d'exploitation
           apparaissaient donc comme deux lignes « / » identiques.
           *Une alerte doit montrer ce qui a été tenté, pas seulement qu'il
           s'est passé quelque chose.* #}
        {% if e.meta.pattern is defined %}
          <div style="font-size:.69rem;color:#b91c1c">motif : {{ e.meta.pattern }}</div>
        {% endif %}
        {% if e.meta.query is defined %}
          <div style="font-size:.69rem;color:#9ca3af">?{{ e.meta.query|slice(0, 120) }}</div>
        {% endif %}
      </td>
      <td>{{ e.statusCode ?: '—' }}</td>
      <td style="font-size:.69rem;color:#9ca3af">{{ e.userAgent|slice(0, 60) }}</td>
    </tr>
  {% else %}
    <tr><td colspan="6">Aucune visite enregistrée.</td></tr>
  {% endfor %}
</table>
{% endblock %}
